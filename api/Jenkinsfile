pipeline {
    agent any

    environment {
        APP_NAME = '4sight-app'
        CONTAINER_NAME = '4sight-container'
        NGINX_CONTAINER = 'nginx-container'
        APP_PORT = '8010'

        OTEL_EXPORTER_OTLP_ENDPOINT = 'http://otel-collector:4317'
        OTEL_SERVICE_NAME = '4sight-service'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Show Workspace') {
            steps {
                bat 'cd'
                bat 'dir'
            }
        }

        stage('Build Docker Image') {
            steps {
                bat 'docker build -t %APP_NAME% .'
            }
        }

        stage('Stop Old App Container') {
            steps {
                bat 'docker rm -f %CONTAINER_NAME% || exit 0'
            }
        }

        stage('Run 4sight Container with OTEL') {
            steps {
                bat '''
                docker run -d --name %CONTAINER_NAME% ^
                  --network monitoring ^
                  -p %APP_PORT%:%APP_PORT% ^
                  -e OTEL_EXPORTER_OTLP_ENDPOINT=%OTEL_EXPORTER_OTLP_ENDPOINT% ^
                  -e OTEL_SERVICE_NAME=%OTEL_SERVICE_NAME% ^
                  %APP_NAME%
                '''
            }
        }

        stage('Check App Logs') {
            steps {
                bat 'docker logs %CONTAINER_NAME% --tail 50'
            }
        }

        stage('Deploy Nginx') {
            steps {
                bat 'docker rm -f %NGINX_CONTAINER% || exit 0'

                bat '''
                docker run -d --name %NGINX_CONTAINER% ^
                  --network monitoring ^
                  -p 80:80 ^
                  -v 