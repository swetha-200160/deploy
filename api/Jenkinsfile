pipeline {
    agent any

    environment {
        APP_NAME = '4sight-app'
        CONTAINER_NAME = '4sight-container'
        NGINX_CONTAINER = 'nginx-container'
        APP_PORT = '8010'

        OTEL_EXPORTER_OTLP_ENDPOINT = 'http://otel-collector:4317'
        OTEL_SERVICE_NAME = '4sight-service'
    }

    stages {

        // STEP 1 - Checkout source code
        stage('Step 1 - Checkout') {
            steps {
                checkout scm
            }
        }

        // STEP 2 - Show workspace files
        stage('Step 2 - Show Workspace') {
            steps {
                bat 'echo Current workspace:'
                bat 'cd'
                bat 'echo Files:'
                bat 'dir'
            }
        }

        // STEP 3 - Build Docker image
        stage('Step 3 - Build Docker Image') {
            steps {
                bat 'docker build -t %APP_NAME% .'
            }
        }

        // STEP 4 - Remove old application container
        stage('Step 4 - Stop Old App Container') {
            steps {
                bat 'docker rm -f %CONTAINER_NAME% || ver > nul'
            }
        }

        // STEP 5 - Run 4sight container with OTEL
        stage('Step 5 - Run 4sight Container with OTEL') {
            steps {
                bat '''
                docker run -d --name %CONTAINER_NAME% ^
                  --network monitoring ^
                  -p %APP_PORT%:%APP_PORT% ^
                  -e OTEL_EXPORTER_OTLP_ENDPOINT=%OTEL_EXPORTER_OTLP_ENDPOINT% ^
                  -e OTEL_SERVICE_NAME=%OTEL_SERVICE_NAME% ^
                  %APP_NAME%
                '''
            }
        }

        // STEP 6 - Check application logs
        stage('Step 6 - Check App Logs') {
            steps {
                bat 'docker logs %CONTAINER_NAME% --tail 50'
            }
        }

        // STEP 7 - Remove old Nginx container
        stage('Step 7 - Stop Old Nginx') {
            steps {
                bat 'docker rm -f %NGINX_CONTAINER% || ver > nul'
            }
        }

        // STEP 8 - Deploy Nginx
        stage('Step 8 - Deploy Nginx') {
            steps {
                bat '''
                docker run -d --name %NGINX_CONTAINER% ^
                  --network monitoring ^
                  -p 80:80 ^
                  -v "%WORKSPACE%\\\\nginx.conf:/etc/nginx/conf.d/default.conf:ro" ^
                  nginx:latest
                '''
            }
        }

        // STEP 9 - Verify Nginx
        stage('Step 9 - Verify Nginx') {
            steps {
                bat 'docker logs %NGINX_CONTAINER% --tail 20'
                bat 'curl -I http://localhost/4sight/docs'
            }
        }

        // STEP 10 - Application health check
        stage('Step 10 - Health Check') {
            steps {
                bat 'curl http://localhost:8010/docs'
            }
        }

        // STEP 11 - Verify Prometheus metrics
        stage('Step 11 - Verify Prometheus Metrics') {
            steps {
                bat 'curl http://localhost:8010/metrics'
            }
        }

        // STEP 12 - Verify Grafana
        stage('Step 12 - Verify Grafana') {
            steps {
                bat 'curl http://localhost:3000/api/health'
            }
        }

        // STEP 13 - Verify OTEL Collector
        stage('Step 13 - Verify OTEL Collector') {
            steps {
                bat 'curl http://localhost:8889/metrics'
            }
        }

        // STEP 14 - List running containers
        stage('Step 14 - List Running Containers') {
            steps {
                bat 'docker ps'
            }
        }
    }

    post {

        success {
            echo 'SUCCESS: 4sight deployed with Nginx, Prometheus, Grafana, and OpenTelemetry.'
        }

        failure {
            echo 'FAILURE: Collecting container logs...'

            bat 'docker logs %CONTAINER_NAME% --tail 100'
            bat 'docker logs %NGINX_CONTAINER% --tail 100'
        }

        always {
            echo 'Pipeline completed.'
        }
    }
}