```groovy
pipeline {
    agent any

    environment {
        APP_NAME = '4sight-app'
        CONTAINER_NAME = '4sight-container'
        NGINX_CONTAINER = 'nginx-container'
        APP_PORT = '8010'

        OTEL_EXPORTER_OTLP_ENDPOINT = 'http://otel-collector:4317'
        OTEL_SERVICE_NAME = '4sight-service'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Check Tools') {
            steps {
                bat '''
                    echo Checking Git...
                    git --version

                    echo Checking Docker...
                    docker --version

                    echo Checking Docker containers...
                    docker ps
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                bat '''
                    echo Building 4sight Docker Image...
                    docker build -t %APP_NAME% .
                '''
            }
        }

        stage('Stop Old App Container') {
            steps {
                bat '''
                    echo Stopping old 4sight container...

                    docker rm -f %CONTAINER_NAME% >nul 2>&1

                    echo Old container removed if it existed.
                '''
            }
        }

        stage('Run 4sight Container') {
            steps {
                bat '''
                    echo Starting 4sight container...

                    docker run -d ^
                      --name %CONTAINER_NAME% ^
                      --network monitoring ^
                      -p %APP_PORT%:%APP_PORT% ^
                      -e OTEL_EXPORTER_OTLP_ENDPOINT=%OTEL_EXPORTER_OTLP_ENDPOINT% ^
                      -e OTEL_SERVICE_NAME=%OTEL_SERVICE_NAME% ^
                      %APP_NAME%
                '''
            }
        }

        stage('Check App Logs') {
            steps {
                bat '''
                    echo Checking 4sight application logs...

                    docker logs %CONTAINER_NAME% --tail 50
                '''
            }
        }

        stage('Stop Old Nginx') {
            steps {
                bat '''
                    echo Stopping old Nginx container...

                    docker rm -f %NGINX_CONTAINER% >nul 2>&1

                    echo Old Nginx container removed if it existed.
                '''
            }
        }

        stage('Deploy Nginx') {
            steps {
                bat '''
                    echo Starting Nginx...

                    docker run -d ^
                      --name %NGINX_CONTAINER% ^
                      --network monitoring ^
                      -p 8011:80 ^
                      -v "%WORKSPACE%\\nginx.conf:/etc/nginx/conf.d/default.conf:ro" ^
                      nginx:latest
                '''
            }
        }

        stage('Verify Nginx') {
            steps {
                bat '''
                    echo Checking Nginx container...

                    docker ps --filter "name=%NGINX_CONTAINER%"

                    echo Checking Nginx logs...

                    docker logs %NGINX_CONTAINER% --tail 20

                    echo Testing Nginx...

                    curl -I http://localhost:8011/4sight/docs
                '''
            }
        }

        stage('Health Check') {
            steps {
                bat '''
                    echo Checking 4sight application...

                    curl -f http://localhost:8010/docs
                '''
            }
        }

        stage('Verify Prometheus Metrics') {
            steps {
                bat '''
                    echo Checking Prometheus metrics...

                    curl -f http://localhost:8010/metrics
                '''
            }
        }

        stage('Verify Grafana') {
            steps {
                bat '''
                    echo Checking Grafana...

                    curl -f http://localhost:3000/api/health
                '''
            }
        }

        stage('Verify OTEL Collector') {
            steps {
                bat '''
                    echo Checking OpenTelemetry Collector...

                    curl -f http://localhost:8889/metrics
                '''
            }
        }

        stage('List Running Containers') {
            steps {
                bat '''
                    echo Running Docker containers:

                    docker ps
                '''
            }
        }
    }

    post {

        success {
            echo 'SUCCESS: 4sight deployed successfully.'
            echo 'Nginx, Prometheus, Grafana and OpenTelemetry verification completed.'
        }

        failure {
            echo 'FAILURE: Pipeline failed.'

            bat '''
                echo ==============================
                echo Docker Containers
                echo ==============================

                docker ps -a
            '''

            bat '''
                echo ==============================
                echo 4sight Container Logs
                echo ==============================

                docker logs %CONTAINER_NAME% --tail 100 2>nul
            '''

            bat '''
                echo ==============================
                echo Nginx Container Logs
                echo ==============================

                docker logs %NGINX_CONTAINER% --tail 100 2>nul
            '''
        }

        always {
            echo 'Pipeline completed.'
        }
    }
}
```
