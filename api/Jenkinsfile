```groovy
pipeline {
    agent any

    environment {
        APP_NAME = '4sight-app'
        CONTAINER_NAME = '4sight-container'
        NGINX_CONTAINER = 'nginx-container'

        APP_PORT = '8010'
        NGINX_PORT = '8011'

        DOCKER_NETWORK = 'monitoring'

        OTEL_EXPORTER_OTLP_ENDPOINT = 'http://otel-collector:4317'
        OTEL_SERVICE_NAME = '4sight-service'
    }

    stages {

        /*
         * Jenkins automatically performs SCM checkout.
         * Therefore, do NOT add another checkout scm stage.
         */

        stage('Show Workspace') {
            steps {
                bat '''
                    echo ==============================
                    echo JENKINS WINDOWS WORKSPACE
                    echo ==============================

                    echo Workspace:
                    echo %WORKSPACE%

                    echo.
                    echo Current Directory:
                    cd

                    echo.
                    echo Workspace Files:
                    dir
                '''
            }
        }

        stage('Check Tools') {
            steps {
                bat '''
                    echo ==============================
                    echo CHECKING TOOLS
                    echo ==============================

                    echo.
                    echo Git Version:
                    git --version

                    echo.
                    echo Docker Version:
                    docker --version

                    echo.
                    echo Docker Information:
                    docker info

                    echo.
                    echo Running Containers:
                    docker ps -a
                '''
            }
        }

        stage('Check Docker Network') {
            steps {
                bat '''
                    echo ==============================
                    echo CHECKING DOCKER NETWORK
                    echo ==============================

                    docker network inspect %DOCKER_NETWORK% >nul 2>&1

                    if errorlevel 1 (
                        echo Docker network does not exist.
                        echo Creating network: %DOCKER_NETWORK%

                        docker network create %DOCKER_NETWORK%

                        if errorlevel 1 (
                            echo ERROR: Failed to create Docker network.
                            exit /b 1
                        )
                    ) else (
                        echo Docker network already exists.
                    )

                    echo.
                    echo Docker Network:
                    docker network inspect %DOCKER_NETWORK%
                '''
            }
        }

        stage('Verify Required Files') {
            steps {
                bat '''
                    echo ==============================
                    echo VERIFYING PROJECT FILES
                    echo ==============================

                    if not exist "Dockerfile" (
                        echo ERROR: Dockerfile not found.
                        exit /b 1
                    )

                    echo Dockerfile found.

                    if not exist "nginx.conf" (
                        echo ERROR: nginx.conf not found.
                        exit /b 1
                    )

                    echo nginx.conf found.

                    echo.
                    echo Project files:
                    dir
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                bat '''
                    echo ==============================
                    echo BUILDING 4SIGHT DOCKER IMAGE
                    echo ==============================

                    docker build -t %APP_NAME% .

                    if errorlevel 1 (
                        echo ERROR: Docker image build failed.
                        exit /b 1
                    )

                    echo.
                    echo Docker image built successfully.

                    docker images %APP_NAME%
                '''
            }
        }

        stage('Stop Old App Container') {
            steps {
                bat '''
                    echo ==============================
                    echo STOPPING OLD 4SIGHT CONTAINER
                    echo ==============================

                    docker rm -f %CONTAINER_NAME% 2>nul

                    if errorlevel 1 (
                        echo No old 4sight container found.
                    ) else (
                        echo Old 4sight container removed.
                    )
                '''
            }
        }

        stage('Run 4sight Container with OTEL') {
            steps {
                bat '''
                    echo ==============================
                    echo STARTING 4SIGHT CONTAINER
                    echo ==============================

                    docker run -d ^
                      --name %CONTAINER_NAME% ^
                      --network %DOCKER_NETWORK% ^
                      -p %APP_PORT%:%APP_PORT% ^
                      -e OTEL_EXPORTER_OTLP_ENDPOINT=%OTEL_EXPORTER_OTLP_ENDPOINT% ^
                      -e OTEL_SERVICE_NAME=%OTEL_SERVICE_NAME% ^
                      %APP_NAME%

                    if errorlevel 1 (
                        echo ERROR: Failed to start 4sight container.
                        exit /b 1
                    )

                    echo.
                    echo 4sight container started successfully.

                    docker ps --filter "name=%CONTAINER_NAME%"
                '''
            }
        }

        stage('Check App Logs') {
            steps {
                bat '''
                    echo ==============================
                    echo 4SIGHT APPLICATION LOGS
                    echo ==============================

                    docker logs %CONTAINER_NAME% --tail 100
                '''
            }
        }

        stage('Stop Old Nginx') {
            steps {
                bat '''
                    echo ==============================
                    echo STOPPING OLD NGINX
                    echo ==============================

                    docker rm -f %NGINX_CONTAINER% 2>nul

                    if errorlevel 1 (
                        echo No old Nginx container found.
                    ) else (
                        echo Old Nginx container removed.
                    )
                '''
            }
        }

        stage('Deploy Nginx') {
            steps {
                bat '''
                    echo ==============================
                    echo DEPLOYING NGINX
                    echo ==============================

                    if not exist "%WORKSPACE%\\nginx.conf" (
                        echo ERROR: nginx.conf not found.
                        echo Expected:
                        echo %WORKSPACE%\\nginx.conf
                        exit /b 1
                    )

                    docker run -d ^
                      --name %NGINX_CONTAINER% ^
                      --network %DOCKER_NETWORK% ^
                      -p %NGINX_PORT%:80 ^
                      -v "%WORKSPACE%\\nginx.conf:/etc/nginx/conf.d/default.conf:ro" ^
                      nginx:latest

                    if errorlevel 1 (
                        echo ERROR: Failed to start Nginx.
                        exit /b 1
                    )

                    echo.
                    echo Nginx started successfully.

                    docker ps --filter "name=%NGINX_CONTAINER%"
                '''
            }
        }

        stage('Verify Nginx') {
            steps {
                bat '''
                    echo ==============================
                    echo VERIFYING NGINX
                    echo ==============================

                    docker logs %NGINX_CONTAINER% --tail 30

                    echo.
                    echo Testing:
                    echo http://localhost:%NGINX_PORT%/4sight/docs

                    curl -I http://localhost:%NGINX_PORT%/4sight/docs

                    if errorlevel 1 (
                        echo ERROR: Nginx verification failed.
                        exit /b 1
                    )

                    echo.
                    echo Nginx verification successful.
                '''
            }
        }

        stage('Health Check') {
            steps {
                bat '''
                    echo ==============================
                    echo 4SIGHT HEALTH CHECK
                    echo ==============================

                    echo Testing:
                    echo http://localhost:%APP_PORT%/docs

                    curl -f http://localhost:%APP_PORT%/docs

                    if errorlevel 1 (
                        echo ERROR: 4sight application health check failed.
                        echo.
                        echo Application logs:
                        docker logs %CONTAINER_NAME% --tail 100
                        exit /b 1
                    )

                    echo.
                    echo 4sight application is healthy.
                '''
            }
        }

        stage('Verify Prometheus Metrics') {
            steps {
                bat '''
                    echo ==============================
                    echo VERIFYING PROMETHEUS METRICS
                    echo ==============================

                    echo Testing:
                    echo http://localhost:%APP_PORT%/metrics

                    curl -f http://localhost:%APP_PORT%/metrics

                    if errorlevel 1 (
                        echo ERROR: Prometheus metrics endpoint failed.
                        exit /b 1
                    )

                    echo.
                    echo Prometheus metrics are available.
                '''
            }
        }

        stage('Verify Grafana') {
            steps {
                bat '''
                    echo ==============================
                    echo VERIFYING GRAFANA
                    echo ==============================

                    echo Testing:
                    echo http://localhost:3000/api/health

                    curl -f http://localhost:3000/api/health

                    if errorlevel 1 (
                        echo ERROR: Grafana health check failed.
                        exit /b 1
                    )

                    echo.
                    echo Grafana is healthy.
                '''
            }
        }

        stage('Verify OTEL Collector') {
            steps {
                bat '''
                    echo ==============================
                    echo VERIFYING OTEL COLLECTOR
                    echo ==============================

                    echo Testing:
                    echo http://localhost:8889/metrics

                    curl -f http://localhost:8889/metrics

                    if errorlevel 1 (
                        echo ERROR: OTEL Collector metrics check failed.
                        exit /b 1
                    )

                    echo.
                    echo OTEL Collector is healthy.
                '''
            }
        }

        stage('List Running Containers') {
            steps {
                bat '''
                    echo ==============================
                    echo ALL DOCKER CONTAINERS
                    echo ==============================

                    docker ps -a
                '''
            }
        }
    }

    post {

        success {
            echo '=============================================='
            echo 'SUCCESS'
            echo '4sight deployment completed successfully.'
            echo 'Nginx + Prometheus + Grafana + OTEL verified.'
            echo '=============================================='
        }

        failure {
            echo '=============================================='
            echo 'PIPELINE FAILED'
            echo 'Collecting Docker logs...'
            echo '=============================================='

            bat '''
                echo.
                echo ==============================
                echo 4SIGHT CONTAINER LOGS
                echo ==============================

                docker logs %CONTAINER_NAME% --tail 100 2>nul
            '''

            bat '''
                echo.
                echo ==============================
                echo NGINX CONTAINER LOGS
                echo ==============================

                docker logs %NGINX_CONTAINER% --tail 100 2>nul
            '''

            bat '''
                echo.
                echo ==============================
                echo ALL DOCKER CONTAINERS
                echo ==============================

                docker ps -a
            '''
        }

        always {
            echo 'Pipeline completed.'
        }
    }
}
```
