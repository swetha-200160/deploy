```groovy
pipeline {
    agent any

    environment {
        APP_NAME        = '4sight-app'
        CONTAINER_NAME  = '4sight-container'
        NGINX_CONTAINER = 'nginx-container'

        APP_PORT        = '8010'
        NGINX_PORT      = '8011'

        DOCKER_NETWORK  = 'monitoring'

        OTEL_SERVICE_NAME          = '4sight-service'
        OTEL_EXPORTER_OTLP_ENDPOINT = 'http://otel-collector:4317'
    }

    stages {

        /*
         * ============================================================
         * 1. SHOW WORKSPACE
         * ============================================================
         */
        stage('Show Workspace') {
            steps {
                bat '''
                    echo ==========================================
                    echo Jenkins Windows Workspace
                    echo ==========================================

                    echo WORKSPACE = %WORKSPACE%

                    echo.
                    echo Current Directory:
                    cd

                    echo.
                    echo Workspace Files:
                    dir
                '''
            }
        }


        /*
         * ============================================================
         * 2. CHECK TOOLS
         * ============================================================
         */
        stage('Check Tools') {
            steps {
                bat '''
                    echo ==========================================
                    echo Checking Required Tools
                    echo ==========================================

                    echo.
                    echo Git:
                    git --version

                    echo.
                    echo Docker:
                    docker --version

                    echo.
                    echo Docker Info:
                    docker info

                    echo.
                    echo Running Containers:
                    docker ps
                '''
            }
        }


        /*
         * ============================================================
         * 3. CHECK / CREATE DOCKER NETWORK
         * ============================================================
         */
        stage('Check Docker Network') {
            steps {
                bat '''
                    echo ==========================================
                    echo Checking Docker Network
                    echo ==========================================

                    docker network inspect %DOCKER_NETWORK% >nul 2>&1

                    if %ERRORLEVEL% EQU 0 (
                        echo Docker network "%DOCKER_NETWORK%" already exists.
                    ) else (
                        echo Docker network "%DOCKER_NETWORK%" does not exist.
                        echo Creating network...

                        docker network create %DOCKER_NETWORK%

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Failed to create Docker network.
                            exit /b 1
                        )

                        echo Docker network created successfully.
                    )
                '''
            }
        }


        /*
         * ============================================================
         * 4. BUILD DOCKER IMAGE
         * ============================================================
         */
        stage('Build Docker Image') {
            steps {
                bat '''
                    echo ==========================================
                    echo Building 4sight Docker Image
                    echo ==========================================

                    docker build -t %APP_NAME% .

                    if %ERRORLEVEL% NEQ 0 (
                        echo ERROR: Docker image build failed.
                        exit /b 1
                    )

                    echo.
                    echo Docker image built successfully.

                    echo.
                    echo Docker Image:
                    docker images %APP_NAME%
                '''
            }
        }


        /*
         * ============================================================
         * 5. STOP OLD 4SIGHT CONTAINER
         * ============================================================
         */
        stage('Stop Old App Container') {
            steps {
                bat '''
                    echo ==========================================
                    echo Removing Old 4sight Container
                    echo ==========================================

                    docker rm -f %CONTAINER_NAME% 2>nul

                    echo Old container removed if it existed.
                '''
            }
        }


        /*
         * ============================================================
         * 6. RUN 4SIGHT CONTAINER
         * ============================================================
         */
        stage('Run 4sight Container with OTEL') {
            steps {
                bat '''
                    echo ==========================================
                    echo Starting 4sight Container
                    echo ==========================================

                    docker run -d ^
                      --name %CONTAINER_NAME% ^
                      --network %DOCKER_NETWORK% ^
                      -p %APP_PORT%:%APP_PORT% ^
                      -e OTEL_SERVICE_NAME=%OTEL_SERVICE_NAME% ^
                      -e OTEL_EXPORTER_OTLP_ENDPOINT=%OTEL_EXPORTER_OTLP_ENDPOINT% ^
                      %APP_NAME%

                    if %ERRORLEVEL% NEQ 0 (
                        echo ERROR: Failed to start 4sight container.
                        exit /b 1
                    )

                    echo.
                    echo 4sight container started successfully.

                    echo.
                    echo Container Status:
                    docker ps --filter "name=%CONTAINER_NAME%"
                '''
            }
        }


        /*
         * ============================================================
         * 7. CHECK 4SIGHT LOGS
         * ============================================================
         */
        stage('Check App Logs') {
            steps {
                bat '''
                    echo ==========================================
                    echo 4sight Application Logs
                    echo ==========================================

                    docker logs %CONTAINER_NAME% --tail 50
                '''
            }
        }


        /*
         * ============================================================
         * 8. STOP OLD NGINX
         * ============================================================
         */
        stage('Stop Old Nginx') {
            steps {
                bat '''
                    echo ==========================================
                    echo Removing Old Nginx Container
                    echo ==========================================

                    docker rm -f %NGINX_CONTAINER% 2>nul

                    echo Old Nginx container removed if it existed.
                '''
            }
        }


        /*
         * ============================================================
         * 9. DEPLOY NGINX
         * ============================================================
         */
        stage('Deploy Nginx') {
            steps {
                bat '''
                    echo ==========================================
                    echo Checking nginx.conf
                    echo ==========================================

                    if not exist "%WORKSPACE%\\nginx.conf" (
                        echo ERROR: nginx.conf not found.
                        echo Expected file:
                        echo %WORKSPACE%\\nginx.conf
                        exit /b 1
                    )

                    echo nginx.conf found.

                    echo.
                    echo ==========================================
                    echo Starting Nginx
                    echo ==========================================

                    docker run -d ^
                      --name %NGINX_CONTAINER% ^
                      --network %DOCKER_NETWORK% ^
                      -p %NGINX_PORT%:80 ^
                      -v "%WORKSPACE%\\nginx.conf:/etc/nginx/conf.d/default.conf:ro" ^
                      nginx:latest

                    if %ERRORLEVEL% NEQ 0 (
                        echo ERROR: Failed to start Nginx.
                        exit /b 1
                    )

                    echo.
                    echo Nginx started successfully.

                    echo.
                    echo Nginx Container:
                    docker ps --filter "name=%NGINX_CONTAINER%"
                '''
            }
        }


        /*
         * ============================================================
         * 10. VERIFY NGINX
         * ============================================================
         */
        stage('Verify Nginx') {
            steps {
                bat '''
                    echo ==========================================
                    echo Nginx Logs
                    echo ==========================================

                    docker logs %NGINX_CONTAINER% --tail 30

                    echo.
                    echo ==========================================
                    echo Testing Nginx /4sight/docs
                    echo ==========================================

                    curl.exe -I http://localhost:%NGINX_PORT%/4sight/docs

                    if %ERRORLEVEL% NEQ 0 (
                        echo ERROR: Nginx verification failed.
                        exit /b 1
                    )

                    echo.
                    echo Nginx verification successful.
                '''
            }
        }


        /*
         * ============================================================
         * 11. APPLICATION HEALTH CHECK
         * ============================================================
         */
        stage('Health Check') {
            steps {
                bat '''
                    echo ==========================================
                    echo Testing 4sight Application
                    echo ==========================================

                    curl.exe -f http://localhost:%APP_PORT%/docs

                    if %ERRORLEVEL% NEQ 0 (
                        echo ERROR: 4sight health check failed.
                        exit /b 1
                    )

                    echo.
                    echo 4sight application is healthy.
                '''
            }
        }


        /*
         * ============================================================
         * 12. PROMETHEUS METRICS
         * ============================================================
         */
        stage('Verify Prometheus Metrics') {
            steps {
                bat '''
                    echo ==========================================
                    echo Testing Prometheus Metrics
                    echo ==========================================

                    curl.exe -f http://localhost:%APP_PORT%/metrics

                    if %ERRORLEVEL% NEQ 0 (
                        echo ERROR: Prometheus metrics endpoint failed.
                        exit /b 1
                    )

                    echo.
                    echo Prometheus metrics are available.
                '''
            }
        }


        /*
         * ============================================================
         * 13. GRAFANA
         * ============================================================
         */
        stage('Verify Grafana') {
            steps {
                bat '''
                    echo ==========================================
                    echo Testing Grafana
                    echo ==========================================

                    curl.exe -f http://localhost:3000/api/health

                    if %ERRORLEVEL% NEQ 0 (
                        echo ERROR: Grafana health check failed.
                        exit /b 1
                    )

                    echo.
                    echo Grafana is healthy.
                '''
            }
        }


        /*
         * ============================================================
         * 14. OTEL COLLECTOR
         * ============================================================
         */
        stage('Verify OTEL Collector') {
            steps {
                bat '''
                    echo ==========================================
                    echo Testing OpenTelemetry Collector
                    echo ==========================================

                    curl.exe -f http://localhost:8889/metrics

                    if %ERRORLEVEL% NEQ 0 (
                        echo ERROR: OTEL Collector verification failed.
                        exit /b 1
                    )

                    echo.
                    echo OTEL Collector is healthy.
                '''
            }
        }


        /*
         * ============================================================
         * 15. FINAL CONTAINER LIST
         * ============================================================
         */
        stage('List Running Containers') {
            steps {
                bat '''
                    echo ==========================================
                    echo All Docker Containers
                    echo ==========================================

                    docker ps -a

                    echo.
                    echo ==========================================
                    echo Monitoring Network
                    echo ==========================================

                    docker network inspect %DOCKER_NETWORK%
                '''
            }
        }
    }


    /*
     * ================================================================
     * POST ACTIONS
     * ================================================================
     */
    post {

        success {
            echo '================================================'
            echo 'SUCCESS'
            echo '4sight deployment completed successfully.'
            echo 'Nginx + Prometheus + Grafana + OTEL verified.'
            echo '================================================'
        }

        failure {
            echo '================================================'
            echo 'PIPELINE FAILED'
            echo 'Collecting Docker logs...'
            echo '================================================'

            bat '''
                echo.
                echo ==========================================
                echo 4sight Container Logs
                echo ==========================================

                docker logs %CONTAINER_NAME% --tail 100 2>nul

                echo.
                echo ==========================================
                echo Nginx Container Logs
                echo ==========================================

                docker logs %NGINX_CONTAINER% --tail 100 2>nul

                echo.
                echo ==========================================
                echo All Docker Containers
                echo ==========================================

                docker ps -a
            '''
        }

        always {
            echo 'Pipeline completed.'
        }
    }
}
```
