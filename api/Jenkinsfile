pipeline {
    agent any

    environment {
        APP_NAME = '4sight-app'
        CONTAINER_NAME = '4sight-container'
        NGINX_CONTAINER = 'nginx-container'
        APP_PORT = '8010'
    }

    stages {

        stage('Check Tools') {
            steps {
                bat 'git --version'
                bat 'docker --version'
                bat 'docker ps'
            }
        }

        stage('Build Docker Image') {
            steps {
                bat 'docker build -t %APP_NAME% .'
            }
        }

        stage('Remove Old App Container') {
            steps {
                bat 'docker rm -f %CONTAINER_NAME% 2>nul'
            }
        }

        stage('Run App Container') {
            steps {
                bat '''
                docker run -d ^
                --name %CONTAINER_NAME% ^
                --network monitoring ^
                -p %APP_PORT%:%APP_PORT% ^
                %APP_NAME%
                '''
            }
        }

        stage('Remove Old Nginx') {
            steps {
                bat 'docker rm -f %NGINX_CONTAINER% 2>nul'
            }
        }

        stage('Run Nginx') {
            steps {
                bat '''
                docker run -d ^
                --name %NGINX_CONTAINER% ^
                --network monitoring ^
                -p 8011:80 ^
                -v "%WORKSPACE%\\\\nginx.conf:/etc/nginx/conf.d/default.conf:ro" ^
                nginx:latest
                '''
            }
        }

        stage('Health Check') {
            steps {
                bat 'curl http://localhost:8011/4sight/docs'
            }
        }

        stage('List Containers') {
            steps {
                bat 'docker ps'
            }
        }
    }

    post {
        success {
            echo '4sight deployed successfully'
        }

        failure {
            echo 'Deployment failed'
            bat 'docker logs %CONTAINER_NAME% --tail 50 2>nul'
            bat 'docker logs %NGINX_CONTAINER% --tail 50 2>nul'
            bat 'docker ps -a'
        }

        always {
            echo 'Pipeline completed'
        }
    }
}