pipeline {
    agent any

    environment {
        APP_NAME = '4sight-app'
        CONTAINER_NAME = '4sight-container'
        NGINX_CONTAINER = 'nginx-container'
        APP_PORT = '8010'

        // OpenTelemetry
        OTEL_EXPORTER_OTLP_ENDPOINT = 'http://otel-collector:4317'
        OTEL_SERVICE_NAME = '4sight-service'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Show Workspace') {
            steps {
                sh 'pwd'
                sh 'ls -la'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t ${APP_NAME} .'
            }
        }

        stage('Stop Old App Container') {
            steps {
                sh 'docker rm -f ${CONTAINER_NAME} || true'
            }
        }

        stage('Run 4sight Container with OTEL') {
            steps {
                sh '''
                docker run -d --name ${CONTAINER_NAME} \
                  --network monitoring \
                  -p ${APP_PORT}:${APP_PORT} \
                  -e OTEL_EXPORTER_OTLP_ENDPOINT=${OTEL_EXPORTER_OTLP_ENDPOINT} \
                  -e OTEL_SERVICE_NAME=${OTEL_SERVICE_NAME} \
                  ${APP_NAME}
                '''
            }
        }

        stage('Check App Logs') {
            steps {
                sh 'docker logs ${CONTAINER_NAME} --tail 50 || true'
            }
        }

        stage('Deploy Nginx') {
            steps {
                sh 'docker rm -f ${NGINX_CONTAINER} || true'

                sh '''
                docker run -d --name ${NGINX_CONTAINER} \
                  --network monitoring \
                  -p 80:80 \
                  -v $WORKSPACE/nginx.conf:/etc/nginx/conf.d/default.conf:ro \
                  nginx:latest
                '''
            }
        }

        stage('Verify Nginx') {
            steps {
                sh 'docker logs ${NGINX_CONTAINER} --tail 20 || true'
                sh 'curl -I http://localhost/4sight/docs'
            }
        }

        stage('Health Check') {
            steps {
                sh 'curl -f http://localhost:8010/docs > /dev/null'
            }
        }

        stage('Verify Prometheus Metrics') {
            steps {
                sh 'curl -f http://localhost:8010/metrics | head'
            }
        }

        stage('Verify Grafana') {
            steps {
                sh 'curl -f http://localhost:3000/api/health'
            }
        }

        stage('Verify OTEL Collector') {
            steps {
                sh 'curl -f http://localhost:8889/metrics | head'
            }
        }

        stage('List Running Containers') {
            steps {
                sh 'docker ps'
            }
        }
    }

    post {

        success {
            echo '4sight deployed successfully with Nginx, Prometheus, Grafana, and OpenTelemetry.'
        }

        failure {
            echo 'Pipeline failed. Collecting logs...'

            sh 'docker logs ${CONTAINER_NAME} --tail 100 || true'
            sh 'docker logs ${NGINX_CONTAINER} --tail 100 || true'
        }

        always {
            echo 'Pipeline completed.'
        }
    }
}